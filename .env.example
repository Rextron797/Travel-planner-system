# Copy this file to .env when you want to use live APIs.
WEATHER_API_KEY=YOUR_WEATHER_API_KEY
PLACES_API_KEY=YOUR_PLACES_API_KEY
HOTELS_API_KEY=YOUR_HOTELS_API_KEY
MAPS_API_KEY=YOUR_MAPS_API_KEY
CURRENCY_API_KEY=YOUR_CURRENCY_API_KEY
# Leave values as placeholders to keep using built-in demo data.

# --- Live data options -------------------------------------------------------
# Keyless, free providers (Open-Meteo weather + geocoding, Frankfurter currency rates).
# Set to true to get live weather/coordinates/exchange rates without any account.
USE_FREE_APIS=false
# With real keys: WEATHER_API_KEY=OpenWeatherMap, MAPS_API_KEY=Google Geocoding,
# PLACES_API_KEY=OpenTripMap (attractions + hotel names for places not in demo_data),
# CURRENCY_API_KEY=exchangerate-api.com. Open GET /api/status to see what is active.
